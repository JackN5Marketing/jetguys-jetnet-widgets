# Postaviti kao Netlify environment varijable (Site settings > Environment variables),
# ne u ovaj fajl -- .env se ne commit-uje.

JETNET_EMAIL=your-jetnet-account@example.com
JETNET_PASSWORD=your-jetnet-password

# Webflow domen odakle je dozvoljeno zvati funkcije (CORS). Npr. https://www.jetguys.com
# Ostaviti prazno / "*" dok se testira, suziti pre produkcije.
ALLOWED_ORIGIN=*
